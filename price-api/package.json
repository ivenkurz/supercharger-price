{
  "name": "suc-price-api",
  "version": "1.0.0",
  "private": true,
  "description": "Collaborative Supercharger price feed API (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply suc-price --local",
    "migrate:remote": "wrangler d1 migrations apply suc-price --remote",
    "seed:sql": "node scripts/seed.mjs --sql-only",
    "seed:local": "node scripts/seed.mjs --local",
    "seed:remote": "node scripts/seed.mjs --remote",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.112.0"
  },
  "engines": {
    "node": ">=20"
  }
}
